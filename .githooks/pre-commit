#!/bin/sh
# Bumps the patch version in package.json (and the lockfile, if the package
# manager updates it) and stages it, so every commit carries a new version.
# Installed via `core.hooksPath` by the `prepare` script. Skip with --no-verify.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -f package.json ]; then
    echo "pre-commit: no package.json at repo root, skipping version bump." >&2
    exit 0
fi

# Pick the project's own package manager from its lockfile.
if [ -f yarn.lock ]; then
    pm=yarn
    lockfile=yarn.lock
elif [ -f package-lock.json ]; then
    pm=npm
    lockfile=package-lock.json
else
    pm=npm
    lockfile=
fi

if ! command -v "$pm" >/dev/null 2>&1; then
    echo "pre-commit: '$pm' not found on PATH, cannot bump version. Aborting commit." >&2
    exit 1
fi

# The manifest/lockfile are staged wholesale below, so refuse to silently
# sweep unrelated unstaged edits in them into this commit.
for f in package.json $lockfile; do
    if ! git diff --quiet -- "$f"; then
        echo "pre-commit: $f has unstaged changes; stage or stash them first. Aborting commit." >&2
        exit 1
    fi
done

old_version=$(node -p "require('./package.json').version")

case "$pm" in
    npm)
        npm version patch --no-git-tag-version >/dev/null
        ;;
    yarn)
        # Yarn 1 needs explicit flags to skip the tag/commit; Yarn 2+ never
        # tags or commits from `yarn version`.
        if yarn --version | grep -q '^1\.'; then
            yarn version --patch --no-git-tag-version --no-commit-hooks >/dev/null
        else
            yarn version patch >/dev/null
        fi
        ;;
esac

new_version=$(node -p "require('./package.json').version")
if [ "$new_version" = "$old_version" ]; then
    echo "pre-commit: version bump failed (still $old_version). Aborting commit." >&2
    exit 1
fi

git add package.json
if [ -n "$lockfile" ] && [ -f "$lockfile" ]; then
    git add "$lockfile"
fi

echo "pre-commit: version $old_version -> $new_version"
